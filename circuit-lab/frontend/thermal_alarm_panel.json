{
  "name": "Industrial Thermal Monitoring & Alarm Panel",
  "description": "A resistor-divider temperature sensor feeds an ESP32 ADC pin. Firmware implements a three-tier annunciator pattern (Normal / Warning / Critical) with PWM-ramped warning brightness and a hysteresis band to prevent alarm chatter near the threshold - the same control pattern used in real equipment monitoring panels.",
  "is_public": true,
  "circuit_json": {
    "nodes": [
      {
        "id": "esp1", "key": "esp32", "name": "ESP32 Dev Board", "category": "board",
        "unit": "V", "default_value": 3.3, "modelType": "dev_board",
        "code": "// Industrial Thermal Monitoring & Alarm Panel\n// -----------------------------------------------\n// Sensor: resistor-divider on GPIO34 (thermistor + fixed resistor).\n// NOTE: this simulator models the thermistor as a fixed resistance, not\n// a live temperature input - to see different alarm states, change the\n// divider resistor's value in the builder and re-run.\n//\n// Outputs:\n//   GPIO2  - Normal indicator (solid green when below WARN_THRESHOLD)\n//   GPIO4  - Warning indicator (PWM-ramped amber, brighter as reading rises)\n//   GPIO5  - Critical indicator (solid red above CRIT_THRESHOLD)\n//   GPIO18 - Piezo alarm (on only in Critical state)\n//\n// A hysteresis band (HYSTERESIS) keeps the panel from flickering between\n// states when the reading sits right at a threshold - it must clear the\n// threshold by that margin before switching states, both rising and falling.\n\nint SENSOR_PIN = 34;\nint LED_NORMAL = 2;\nint LED_WARNING = 4;\nint LED_CRITICAL = 5;\nint BUZZER_PIN = 18;\n\nint WARN_THRESHOLD = 1800;   // out of 4095 (12-bit ADC)\nint CRIT_THRESHOLD = 3000;\nint HYSTERESIS = 100;\n\nint state = 0; // 0 = normal, 1 = warning, 2 = critical\n\nvoid setup() {\n  pinMode(LED_NORMAL, OUTPUT);\n  pinMode(LED_WARNING, OUTPUT);\n  pinMode(LED_CRITICAL, OUTPUT);\n  pinMode(BUZZER_PIN, OUTPUT);\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  int reading = analogRead(SENSOR_PIN);\n\n  // state machine with hysteresis - only cross a threshold once we're\n  // clearly past it, in whichever direction we're currently moving\n  if (state == 0 && reading > WARN_THRESHOLD + HYSTERESIS) {\n    state = 1;\n  } else if (state == 1 && reading > CRIT_THRESHOLD + HYSTERESIS) {\n    state = 2;\n  } else if (state == 1 && reading < WARN_THRESHOLD - HYSTERESIS) {\n    state = 0;\n  } else if (state == 2 && reading < CRIT_THRESHOLD - HYSTERESIS) {\n    state = 1;\n  }\n\n  digitalWrite(LED_NORMAL, state == 0 ? HIGH : LOW);\n  digitalWrite(LED_CRITICAL, state == 2 ? HIGH : LOW);\n  digitalWrite(BUZZER_PIN, state == 2 ? HIGH : LOW);\n\n  if (state == 1) {\n    // brightness scales with how far into the warning band we are\n    int span = CRIT_THRESHOLD - WARN_THRESHOLD;\n    int into = reading - WARN_THRESHOLD;\n    int brightness = (into * 255) / span;\n    if (brightness < 40) brightness = 40;   // stay visible even just past threshold\n    if (brightness > 255) brightness = 255;\n    analogWrite(LED_WARNING, brightness);\n  } else {\n    analogWrite(LED_WARNING, 0);\n  }\n\n  Serial.print(\"Reading: \");\n  Serial.print(reading);\n  Serial.print(\" | State: \");\n  Serial.println(state);\n\n  delay(200);\n}\n",
        "x": 0, "z": 0,
